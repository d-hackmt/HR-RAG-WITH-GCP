# Copy this file to .streamlit/secrets.toml and fill in your real values.
# secrets.toml is never committed — only this .example file is.
#
# This is ONLY for the Google OAuth login gate (st.login / st.user in
# app.py). It is separate from .env — config.py never reads this file.
# Without it, app.py's _auth_configured() returns False and the app runs
# in "Open local mode" (no login screen) instead of crashing.
#
# Where these values come from (see docs/13-access-control.md):
#   client_id / client_secret  -> Google Cloud Console, OAuth 2.0 Client ID
#   cookie_secret              -> generate locally: openssl rand -hex 32
#   redirect_uri                -> http://localhost:8501/oauth2callback for
#                                  local testing; your Cloud Run URL +
#                                  /oauth2callback in production

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "your-openssl-rand-hex-32-value-here"

[auth.google]
client_id = "your-oauth-client-id.apps.googleusercontent.com"
client_secret = "your-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
