# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.

PROJECT_ID=your-gcp-project-id
LOCATION=us-central1     # Vertex AI region

# Cloud Storage — where the raw policy documents are uploaded
GCS_BUCKET_NAME=your-bucket-name

# Jina AI — embeddings + reranker
JINA_API_KEY=your-jina-api-key-here

# Models — optional overrides (defaults in hr_assistant/config.py).
# gemini-2.5-flash retires ~2026-10-20 — set LLM_MODEL_NAME to a Gemini 3.x
# Flash model before then. Changing EMBEDDING_MODEL_NAME also needs
# `python ingest.py --force` (vector dimension changes).
# LLM_MODEL_NAME=gemini-2.5-flash
# EMBEDDING_MODEL_NAME=jina-embeddings-v2-base-en
# RERANKER_MODEL_NAME=jina-reranker-v2-base-multilingual

# Qdrant Cloud — the vector store
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=hr_policies

# Second collection — HR docs + non-HR noise together. `ingest.py` builds
# it alongside the clean one; the app connects to the clean collection.
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# LangSmith — request tracing. Free API key at smith.langchain.com.
# Set LANGSMITH_TRACING=true to send traces; the app shows a green/grey
# status line in the sidebar.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=hr-policy-assistant
